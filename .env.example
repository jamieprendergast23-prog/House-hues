# Browser app (safe to expose; RLS protects the data)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Netlify functions only (set in Netlify, NEVER prefix with VITE_)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SITE_URL=https://househues.netlify.app

# Optional: booking email alerts via resend.com
RESEND_API_KEY=
NOTIFY_EMAIL=owner@example.com
FROM_EMAIL=
